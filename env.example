DEBUG=true

# LLM — required for real ReAct planning (Supervisor) and RAG answer
# synthesis (Knowledge Agent). Without a key for the selected provider,
# both fall back to deterministic/raw-retrieval behavior automatically.
#
# LLM_PROVIDER: "gemini" (default) or "groq" — only fill in the keys
# for the one you're using.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database
DATABASE_PATH=backend/database/hospital.db

# RAG (ChromaDB) — after adding documents to docs/, run:
#   python -m backend.rag.ingest
RAG_DOCS_DIR=docs
RAG_INDEX_DIR=backend/rag/index

# Nearby Hospitals — pick one:
#   mock   = no setup, static placeholder data (default)
#   osm    = free, no API key — OpenStreetMap Overpass API
#   google = best data quality, requires GOOGLE_MAPS_API_KEY + billing
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
DEFAULT_LATITUDE=9.1698
DEFAULT_LONGITUDE=77.8778

# Twilio WhatsApp (mock by default for the demo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
USE_MOCK_WHATSAPP=true

# API
API_HOST=0.0.0.0
API_PORT=8000
